<?xml version="1.0" encoding="utf-8"?>
<!--
  Defence in depth: the app declares no INTERNET permission, but if one is ever
  added by a future dependency, cleartext HTTP stays blocked.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
